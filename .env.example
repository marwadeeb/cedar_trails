# Copy to `.env` and fill in. Never commit `.env`.

# Groq (free): https://console.groq.com/keys  - used for Qwen3.8-27B (default) and GPT-OSS
GROQ_API_KEY=

# Google AI Studio (free): https://aistudio.google.com/apikey  - Gemini runs and the LLM judge
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional local models via Ollama
OLLAMA_URL=http://localhost:11434

# Optional: override the default model (provider:model)
# AGENT_MODEL=groq:openai/gpt-oss-20b
